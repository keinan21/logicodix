{
  "name": "logicodix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EcoRush — game balap multiplayer untuk siswa SMP (LOGICODIX 2026)",
  "scripts": {
    "dev": "concurrently -n web,server \"bun run dev:web\" \"bun run dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "e2e": "playwright test --config tests/browser/playwright.config.ts && playwright test --config tests/lobby-browser/playwright.config.ts",
    "dev:dummy": "concurrently -n web,dummy \"bun run dev:web\" \"bun run dev:dummy:server\"",
    "dev:dummy:server": "tsx watch scripts/dev-dummy.ts",
    "start:dummy": "PORT=3000 tsx scripts/dev-dummy.ts",
    "check": "tsc --noEmit && prettier --check . && bun run check-content",
    "format": "prettier --write .",
    "check-content": "tsx scripts/check-content.ts",
    "load": "tsx scripts/load-test.ts",
    "ai-live": "tsx scripts/ai-live-check.ts"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@sideid/id-profanity-filter": "1.13.0",
    "express": "5.3.0",
    "obscenity": "0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "playwright": "^1.40.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
